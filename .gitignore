# Ignore loose files under repro_rented/ but allow cell_* subdirectories
# (preds.jsonl, logs, manifests) to be committed. Note: a trailing-slash
# pattern on the parent (experiments/repro_rented/) silently kills any
# downstream negation, so we ignore at the file-name level instead.
experiments/repro_rented/*
!experiments/repro_rented/cell_*/
!experiments/repro_rented/.gitkeep
traces/
!experiments/.gitkeep

# --- Third-party clones (recreatable via prepare_ruler_data.sh) ---
external/

# --- In-progress drafts (excluded from supplementary tarball too) ---
todo.md
todo1.md
todo2.md
texput.log

# --- Other-paper style extracts (not for distribution) ---
paper/Paper_style_extract/

# --- Paper build ---
paper/
halo_supplement*.tgz
