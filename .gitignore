paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/_minted-*/
paper/sections/*.aux
paper/*.pdf
!paper/figures/*.pdf

# --- In-progress next-paper drafts (not part of this submission) ---
next_paper/

# --- Claude Code local config (not part of source) ---
.claude/

