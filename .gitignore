.env
.env.*
!*.env.example

# --- One-shot ModelScope download / launcher tqdm noise ---
experiments/followups_reviewer_v2/_modelscope_logs/

# --- In-flight cell summaries (none currently in flight) ---
# A long-running cell may write the bootstrap summary skeleton before
# all preds.jsonl rows are filled in. Until the watcher confirms n
# matches args, the summary contains NaN for the in-flight method;
# don't let those into the supplement. The preds files are kept (they
# are valid per-prompt observations); only the rolled-up summary is
# gated until completion. Cell D n=50 finished 2026-05-19 05:07;
# Cell E Path D n=50 finished 2026-05-19 16:36; both now tracked.
experiments/followups_reviewer_v2/*/_stage/

# Round-24 run logs (not part of paper artifact)
experiments/fu_w1c_e2e/_logs/
experiments/fu_w1c_e2e/streamed_v2/path_d/
experiments/fu_w1c_e2e/single_launch/path_d/
experiments/followups_reviewer_v2/_niah_n50_logs/
experiments/followups_reviewer_v2/_niah_commit_logs/
experiments/discourse_benchmark/_logs/
experiments/triton_single_launch_bench/sweep_master.log

# Large intermediate data files — never auto-commit
experiments/*/seed_*/en_qa/_stage/
experiments/*/*/seed_*/en_qa/_stage/
*_stage/en_qa.jsonl

# Internal-only review / cover-letter notes (DO NOT submit)
paper/COVER_LETTER_NOTES.md
paper/REVIEW_ROUND*.md
docs/internal/

# Intermediate dataset stage copies (huge, never commit)
**/_stage/
**/_stage/*.jsonl

# Run logs (often contain stack traces with absolute paths -> anonymity leak)
experiments/**/_logs/
